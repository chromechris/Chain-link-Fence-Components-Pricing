{
  "_comment": "Maps each feed key to lines in a supplier quote CSV. `patterns` are case-insensitive regexes tested against the quote's description column; `skus` match the sku/part column exactly. `divideBy` converts a per-stick or per-box price to the feed unit (e.g. 21' pipe stick -> per foot). Edit these to match how YOUR supplier words their lines.",
  "settings.markup": { "patterns": ["^__never__$"] },
  "settings.tax": { "patterns": ["^__never__$"] },
  "fabricRoll.4": { "patterns": ["\\b4[' ]?(ft|')?\\s*[x×]\\s*50.*\\b9\\s*ga.*(galv|gaw)", "\\b48\"?.*50'.*9\\s*ga.*(galv|gaw)"] },
  "fabricRoll.5": { "patterns": ["\\b5[' ]?(ft|')?\\s*[x×]\\s*50.*\\b9\\s*ga.*(galv|gaw)", "\\b60\"?.*50'.*9\\s*ga.*(galv|gaw)"] },
  "fabricRoll.6": { "patterns": ["\\b6[' ]?(ft|')?\\s*[x×]\\s*50.*\\b9\\s*ga.*(galv|gaw)", "\\b72\"?.*50'.*9\\s*ga.*(galv|gaw)"] },
  "fabricRoll.8": { "patterns": ["\\b8[' ]?(ft|')?\\s*[x×]\\s*50.*\\b9\\s*ga.*(galv|gaw)", "\\b96\"?.*50'.*9\\s*ga.*(galv|gaw)"] },
  "fabricRoll.10": { "patterns": ["\\b10[' ]?(ft|')?\\s*[x×]\\s*50.*\\b9\\s*ga.*(galv|gaw)", "\\b120\"?.*50'.*9\\s*ga.*(galv|gaw)"] },
  "fabricRoll.12": { "patterns": ["\\b12[' ]?(ft|')?\\s*[x×]\\s*50.*\\b9\\s*ga.*(galv|gaw)", "\\b144\"?.*50'.*9\\s*ga.*(galv|gaw)"] },
  "fabricMods.ga11": { "patterns": ["^__multiplier: price a 6x50 11 ga roll and divide by fabricRoll.6 by hand__$"] },
  "fabricMods.ga115": { "patterns": ["^__multiplier__$"] },
  "fabricMods.ga6": { "patterns": ["^__multiplier__$"] },
  "fabricMods.gaw2": { "patterns": ["^__multiplier__$"] },
  "fabricMods.pvc": { "patterns": ["^__multiplier__$"] },
  "fabricMods.alum": { "patterns": ["^__multiplier__$"] },
  "fabricMods.mesh175": { "patterns": ["^__multiplier__$"] },
  "fabricMods.meshSmall": { "patterns": ["^__multiplier__$"] },
  "pipeFt.p166": { "patterns": ["1[\\s-]*5/8.*(pipe|rail|tube)", "1\\.660.*(pipe|rail|tube)"], "divideBy": 21 },
  "pipeFt.p1875": { "patterns": ["1[\\s-]*7/8.*(pipe|rail|tube)", "1\\.875.*(pipe|rail|tube)"], "divideBy": 21 },
  "pipeFt.p19": { "patterns": ["1\\.900?.*(pipe|post|tube)"], "divideBy": 21 },
  "pipeFt.p2375": { "patterns": ["2[\\s-]*3/8.*(pipe|post|tube)", "2\\.375.*(pipe|post|tube)"], "divideBy": 21 },
  "pipeFt.p2875": { "patterns": ["2[\\s-]*7/8.*(pipe|post|tube)", "2\\.875.*(pipe|post|tube)"], "divideBy": 21 },
  "pipeFt.p4": { "patterns": ["\\b4(\\.000|\")?\\s*(od|o\\.d\\.).*(pipe|post|tube)", "\\b4\"\\s*(pipe|post)"], "divideBy": 21 },
  "pipeFt.p6625": { "patterns": ["6[\\s-]*5/8.*(pipe|post|tube)", "6\\.625.*(pipe|post|tube)"], "divideBy": 21 },
  "pipeFt.p8625": { "patterns": ["8[\\s-]*5/8.*(pipe|post|tube)", "8\\.625.*(pipe|post|tube)"], "divideBy": 21 },
  "wire.tension": { "patterns": ["tension wire.*7\\s*ga", "7\\s*ga.*tension wire", "coil spring wire"], "divideBy": 1 },
  "wire.barb": { "patterns": ["barb(ed)? wire"], "divideBy": 1 },
  "fit.loopcap": { "patterns": ["loop cap", "eye top", "line post top"] },
  "fit.domecap": { "patterns": ["dome cap", "post cap", "acorn cap"] },
  "fit.railend": { "patterns": ["rail end", "brace end", "end cup"] },
  "fit.braceband": { "patterns": ["brace band"] },
  "fit.tband": { "patterns": ["tension band"] },
  "fit.tbarft": { "patterns": ["tension bar"], "divideBy": 6, "_note": "suppliers quote tension bars per bar; set divideBy to the bar length (ft) on the quoted line" },
  "fit.bolt": { "patterns": ["carriage bolt"] },
  "fit.truss": { "patterns": ["truss rod", "truss tightener"] },
  "fit.sleeve": { "patterns": ["(rail|top rail) sleeve", "swedge sleeve"] },
  "fit.clamp": { "patterns": ["(line rail|boulevard|rail) clamp"] },
  "fit.tie": { "patterns": ["tie wire", "fence tie", "aluminum tie"] },
  "fit.hog": { "patterns": ["hog ring"] },
  "fit.barbarm": { "patterns": ["barb arm", "barbed wire arm"] },
  "gate.walk.4": { "patterns": ["walk gate.*[x×]\\s*4[' ]?(ft|')?\\b", "walk gate.*\\b4[' ]?(ft|')?\\s*(h\\b|high|tall)"], "_note": "walk gates are quoted width x height; the height is the number after the x" },
  "gate.walk.5": { "patterns": ["walk gate.*[x×]\\s*5[' ]?(ft|')?\\b", "walk gate.*\\b5[' ]?(ft|')?\\s*(h\\b|high|tall)"] },
  "gate.walk.6": { "patterns": ["walk gate.*[x×]\\s*6[' ]?(ft|')?\\b", "walk gate.*\\b6[' ]?(ft|')?\\s*(h\\b|high|tall)"] },
  "gate.walk.7": { "patterns": ["walk gate.*[x×]\\s*7[' ]?(ft|')?\\b", "walk gate.*\\b7[' ]?(ft|')?\\s*(h\\b|high|tall)"] },
  "gate.dbl.12": { "patterns": ["double.*gate.*\\b12[' ]?(ft|')?\\s*(w|wide|opening|x)"] },
  "gate.dbl.16": { "patterns": ["double.*gate.*\\b16[' ]?(ft|')?\\s*(w|wide|opening|x)"] },
  "gate.dbl.20": { "patterns": ["double.*gate.*\\b20[' ]?(ft|')?\\s*(w|wide|opening|x)"] },
  "gate.dbl.24": { "patterns": ["double.*gate.*\\b24[' ]?(ft|')?\\s*(w|wide|opening|x)"] },
  "gate.hingepr": { "patterns": ["hinge (set|pair|kit)", "male.*female hinge"] },
  "gate.latch": { "patterns": ["fork latch", "gate latch"] },
  "gate.droprod": { "patterns": ["drop rod", "cane bolt"] },
  "concrete.80": { "patterns": ["80\\s*lb.*(concrete|mix)", "concrete.*80\\s*lb"] },
  "concrete.60": { "patterns": ["60\\s*lb.*(concrete|mix)", "concrete.*60\\s*lb"] }
}
